{
  "version": "1.0",
  "provider": {
    "domain": "submit.example-journal.com",
    "name": "Example Journal Submission System",
    "contact": "support@example-journal.com",
    "locale": "en-US"
  },
  "registry": {
    "url": "https://registry.aimanifest.io/verify",
    "signature": "sha256:PLACEHOLDER_REPLACE_WITH_ACTUAL_HASH",
    "certified_at": "2026-04-20T00:00:00Z"
  },
  "task": {
    "id": "manuscript_submission",
    "name": "Submit New Manuscript",
    "description": "Full workflow for submitting a new manuscript to this journal",
    "timeout_seconds": 600,
    "requires_login": true,
    "login_check_selector": "#author-dashboard"
  },
  "prerequisites": [
    {
      "description": "Must be logged in as corresponding author",
      "check_selector": "#author-dashboard"
    },
    {
      "description": "Must be on the dashboard page",
      "check_url_contains": "/dashboard"
    }
  ],
  "steps": [
    {
      "step": 1,
      "action": "click",
      "selector": "#btn-new-submission",
      "description": "Click 'Submit New Manuscript' button",
      "wait_for_selector": "#article-type-select",
      "note": "Button is only visible when logged in as an author"
    },
    {
      "step": 2,
      "action": "select",
      "selector": "#article-type-select",
      "description": "Select article type",
      "source": "user_input",
      "user_input_label": "Article Type (e.g. Research Article, Review, Letter)"
    },
    {
      "step": 3,
      "action": "click",
      "selector": "#btn-save-continue",
      "description": "Save article type and proceed to Step 2",
      "wait_for_selector": "#manuscript-title",
      "note": "CRITICAL: Must click Save before proceeding. Next tab is locked until saved."
    },
    {
      "step": 4,
      "action": "fill",
      "selector": "#manuscript-title",
      "description": "Enter manuscript title",
      "source": "user_input",
      "user_input_label": "Manuscript Title"
    },
    {
      "step": 5,
      "action": "fill",
      "selector": "#abstract-field",
      "description": "Enter abstract",
      "source": "user_input",
      "user_input_label": "Abstract"
    },
    {
      "step": 6,
      "action": "click",
      "selector": "#tab-authors",
      "description": "Navigate to Authors tab",
      "wait_for_selector": "#corresponding-author-email"
    },
    {
      "step": 7,
      "action": "fill",
      "selector": "#corresponding-author-email",
      "description": "Confirm corresponding author email",
      "source": "user_input",
      "user_input_label": "Corresponding Author Email"
    },
    {
      "step": 8,
      "action": "click",
      "selector": "#tab-files",
      "description": "Navigate to File Upload tab",
      "wait_for_selector": "#main-document-upload"
    },
    {
      "step": 9,
      "action": "upload",
      "selector": "#main-document-upload",
      "description": "Upload main manuscript file",
      "source": "user_input",
      "user_input_label": "Main Manuscript File",
      "allowed_extensions": [".pdf", ".docx", ".tex"],
      "max_file_size_mb": 30,
      "wait_after_ms": 10000,
      "note": "CRITICAL: Wait 10 seconds after upload before clicking Next. Premature click causes silent failure."
    },
    {
      "step": 10,
      "action": "click",
      "selector": "#btn-submit-review",
      "description": "Submit manuscript for review",
      "wait_for_selector": "#submission-confirmation",
      "note": "Final submit — irreversible. Confirm with user before executing."
    }
  ],
  "common_errors": [
    {
      "symptom_selector": "#error-file-size",
      "description": "File exceeds size limit",
      "resolution": "Compress images or split supplementary files. Maximum 30MB for main document."
    },
    {
      "symptom_selector": "#error-tab-locked",
      "description": "Next tab is locked / greyed out",
      "resolution": "Return to current tab, click Save, then retry navigation."
    }
  ],
  "on_success": {
    "success_selector": "#submission-confirmation",
    "success_url_contains": "/confirmation",
    "message": "Manuscript submitted successfully. Confirmation number is shown on screen."
  }
}
