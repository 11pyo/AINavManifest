{
  "version": "2.0",
  "origin": "https://submit.example-journal.org",
  "expires": "2026-12-04T00:00:00Z",
  "frameworkHints": {
    "name": "react",
    "renderingModel": "client-rendered"
  },
  "knownTraps": [
    {
      "trapId": "details-tab-locked",
      "category": "hidden-required",
      "locator": {
        "role": "tab",
        "name": "Manuscript Details"
      },
      "condition": {
        "absent": {
          "role": "textbox",
          "name": "Manuscript Title"
        }
      },
      "recovery": [
        {
          "action": "click",
          "locator": {
            "role": "button",
            "name": "Save and Continue"
          }
        },
        {
          "action": "wait",
          "timeoutMs": 5000
        }
      ],
      "description": "The Manuscript Details tab, which holds the required title and abstract, stays locked until the article type step is saved with Save and Continue."
    },
    {
      "trapId": "upload-processing",
      "category": "delayed-render",
      "locator": {
        "role": "progressbar",
        "name": "Processing main document"
      },
      "condition": {
        "visible": {
          "role": "progressbar",
          "name": "Processing main document"
        }
      },
      "recovery": [
        {
          "action": "wait",
          "timeoutMs": 30000
        },
        {
          "action": "assert",
          "locator": {
            "role": "status",
            "name": "Main document processed"
          }
        }
      ],
      "description": "An uploaded file is processed asynchronously. Moving on before processing finishes loses the file without an error message."
    }
  ],
  "fieldHints": [
    {
      "fieldId": "articleType",
      "locator": {
        "role": "combobox",
        "name": "Article Type"
      },
      "allowedValues": [
        "research-article",
        "review-article",
        "letter"
      ],
      "description": "Option values of the article type list (labels: Research Article, Review Article, Letter)."
    }
  ],
  "shortcuts": [
    {
      "shortcutId": "author-dashboard",
      "target": "/dashboard",
      "label": "Author dashboard"
    }
  ]
}
